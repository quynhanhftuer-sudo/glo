# Sao chép thành .env rồi điền. KHÔNG đưa file .env lên GitHub.
PORT=3000
NODE_ENV=development          # đặt "production" khi chạy thật (bật cookie Secure)

# Tài khoản admin: server tự tạo từ 2 biến này (không đăng ký bằng form được). Đăng nhập bằng Gmail + mật khẩu này.
ADMIN_EMAIL=ban@gmail.com
ADMIN_PASSWORD=doi-mat-khau-nay-8-ky-tu-tro-len

# Chuỗi ngẫu nhiên dài (tuỳ chọn). TRUST_PROXY=1 nếu chạy sau Render/Railway/Nginx.
# APP_SECRET=
# TRUST_PROXY=1
# DATA_DIR=/var/data            # nơi lưu database + ảnh; trên hosting phải là ổ đĩa bền vững

# Số giây không thao tác thì phải đăng nhập lại (mặc định 900 = 15 phút)
# SESSION_IDLE_SEC=900
